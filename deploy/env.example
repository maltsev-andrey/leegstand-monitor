# /etc/leegstand/env   (owner ansible, mode 0600; real values come from ansible vault)
LITELLM_URL=http://GPU_HOST:30900
LITELLM_KEY=sk-REPLACE_leegstand_monitor_key
LLM_MODEL=qwen2.5-7b
PG_DSN=postgresql://leegstand:REPLACE@DB_HOST:5432/leegstand
TG_BOT_TOKEN=REPLACE
TG_CHAT_ID=REPLACE
MAX_ITEMS_PER_RUN=25
LOOKBACK_DAYS=45
