LLM_MODEL={{ leegstand_llm_model }}
PG_DSN=postgresql://{{ leegstand_pg_user }}:{{ vault_leegstand_db_password }}@{{ leegstand_pg_host }}:5432/{{ leegstand_pg_db }}
TG_BOT_TOKEN={{ vault_leegstand_tg_bot_token }}
TG_CHAT_ID={{ vault_leegstand_tg_chat_id }}
CVDR_INDEX={{ leegstand_cvdr_index }}
